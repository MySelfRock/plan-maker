# =========================================
# PLANMAKER SAAS - DEMO ENVIRONMENT
# =========================================
# This configuration is for DEMO/PRESENTATION purposes only
# DO NOT use in production!
# =========================================

# ===================
# Application
# ===================
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
DEMO_MODE=true

# ===================
# Database
# ===================
DATABASE_URL=postgresql://demo:demo123@localhost:5432/planmaker_demo?schema=public

# ===================
# Redis
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================
# JWT Authentication
# ===================
# NOTE: These are demo secrets - change for any real deployment
JWT_SECRET=demo-jwt-secret-change-in-production-12345678901234567890
JWT_REFRESH_SECRET=demo-refresh-secret-change-in-production-12345678901234567890
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===================
# CORS
# ===================
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ===================
# AWS S3 (MinIO for demo)
# ===================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=demo
AWS_SECRET_ACCESS_KEY=demo123demo
AWS_S3_BUCKET=planmaker-assets
AWS_S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ===================
# Google AI (Gemini)
# ===================
# IMPORTANT: Replace with your actual API key for AI features to work
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-pro

# ===================
# Email (SMTP)
# ===================
# For demo, emails are logged to console
# Configure these for real email sending:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=demo@planmaker-demo.local
EMAIL_FROM_NAME=PlanMaker Demo

# ===================
# Google OAuth (Optional)
# ===================
# Leave empty to disable Google login in demo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ===================
# Stripe Payments (Demo Mode)
# ===================
# For demo, use test keys or leave empty
STRIPE_SECRET_KEY=sk_test_demo
STRIPE_WEBHOOK_SECRET=whsec_demo
STRIPE_PRICE_BASIC_MONTHLY=price_demo_basic_monthly
STRIPE_PRICE_PRO_MONTHLY=price_demo_pro_monthly
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_demo_enterprise_monthly

# ===================
# Monitoring & Logging
# ===================
# Sentry - leave empty to disable error tracking in demo
SENTRY_DSN=

# ===================
# Rate Limiting
# ===================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===================
# Demo Credentials
# ===================
# Use these credentials to login:
# Admin: admin@demo.com / Admin123!
# Coach: coach@demo.com / Coach123!
# User: user@demo.com / User123!
