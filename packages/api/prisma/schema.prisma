// Prisma Schema for PlanMaker SaaS
// Multi-tenant white-label platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT (White-label)
// ============================================

model Tenant {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  status            String             @default("active") // active, suspended, trial, cancelled
  theme             Json               // TenantTheme JSON
  config            Json               // TenantConfig JSON
  customDomain      String?            @unique
  subscriptionTier  String?
  billingEmail      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  users             User[]
  profiles          Profile[]
  plans             Plan[]
  templates         Template[]
  exercises         Exercise[]
  subscriptions     Subscription[]
  events            Event[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(uuid())
  tenantId      String
  email         String
  passwordHash  String?   // null for OAuth-only users
  name          String
  role          String    @default("user") // user, coach, admin, super_admin
  authProvider  String    @default("local") // local, google, apple, facebook
  emailVerified Boolean   @default(false)
  locale        String    @default("pt-BR")
  timezone      String    @default("America/Sao_Paulo")
  avatarUrl     String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile       Profile?
  plans         Plan[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  events        Event[]
  createdTemplates Template[]   @relation("CreatedTemplates")

  @@unique([tenantId, email]) // unique email per tenant
  @@index([tenantId])
  @@index([email])
  @@index([tenantId, role]) // For filtering users by role within tenant
  @@index([emailVerified]) // For finding unverified users
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt]) // For cleanup of expired tokens
  @@map("refresh_tokens")
}

// ============================================
// PROFILE & ONBOARDING
// ============================================

model Profile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  tenantId               String
  niche                  String   // fitness, music, study, skills
  level                  String   // beginner, intermediate, advanced, expert
  goals                  String[] // array of goal strings
  constraints            String[] // array of constraint strings
  equipment              String[] // array of equipment strings
  availability           Json     // Availability JSON
  allergies              String?
  medicalNotes           String?
  preferredSessionLength Int?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plans  Plan[]

  @@index([userId])
  @@index([tenantId])
  @@index([niche])
  @@index([tenantId, niche, level]) // For filtering profiles by niche and level
  @@map("profiles")
}

// ============================================
// TEMPLATES
// ============================================

model Template {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  description      String
  niche            String
  level            String
  type             String   // weekly, monthly, 12-week
  weeks            Int?
  rules            Json     // PlanRule JSON
  sampleSessions   Json?
  aiPromptTemplate String   @db.Text
  isPublic         Boolean  @default(false)
  createdBy        String
  tags             String[]
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User   @relation("CreatedTemplates", fields: [createdBy], references: [id])
  plans   Plan[]

  @@index([tenantId])
  @@index([niche, level])
  @@index([isPublic])
  @@map("templates")
}

// ============================================
// EXERCISES
// ============================================

model Exercise {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String
  niche       String
  level       String
  tags        String[]
  equipment   String[]
  duration    Int?     // minutes
  sets        Int?
  reps        String?  // can be "10-12" or just "10"
  intensity   String   // low, moderate, high, very_high
  videoUrl    String?
  imageUrl    String?
  instructions String? @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([niche, level])
  @@index([tags])
  @@map("exercises")
}

// ============================================
// PLANS & SESSIONS
// ============================================

model Plan {
  id         String   @id @default(uuid())
  userId     String
  tenantId   String
  profileId  String
  templateId String?
  name       String
  type       String   // weekly, monthly, 12-week
  status     String   @default("active") // draft, active, paused, completed, archived
  version    Int      @default(1)
  startDate  DateTime
  endDate    DateTime?
  weeks      Int?
  rationale  String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile  Profile   @relation(fields: [profileId], references: [id])
  template Template? @relation(fields: [templateId], references: [id])
  days     PlanDay[]

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([userId, status]) // For fetching user's active/completed plans
  @@index([tenantId, status, createdAt]) // For tenant dashboard, most recent plans first
  @@index([profileId]) // For finding plans by profile
  @@map("plans")
}

model PlanDay {
  id        String   @id @default(uuid())
  planId    String
  date      DateTime
  weekday   String
  isRestDay Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([planId])
  @@index([date])
  @@map("plan_days")
}

model Session {
  id            String    @id @default(uuid())
  planDayId     String
  title         String
  description   String?
  exercises     Json      // SessionExercise[] JSON
  totalDuration Int       // minutes
  intensity     String    // low, moderate, high, very_high
  status        String    @default("pending") // pending, completed, skipped
  completedAt   DateTime?
  feedback      Json?     // Session feedback JSON
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  planDay PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)

  @@index([planDayId])
  @@index([status])
  @@index([planDayId, status]) // For efficient queries of day's sessions by status
  @@index([completedAt]) // For analytics on completion times
  @@map("sessions")
}

// ============================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================

model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  tenantId             String
  planTier             String    // free, starter, pro, team, enterprise
  status               String    // active, trialing, past_due, canceled, unpaid
  stripeSubscriptionId String?   @unique
  stripeCustomerId     String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([userId, status]) // For user subscription status queries
  @@index([tenantId, status]) // For tenant subscription analytics
  @@index([currentPeriodEnd]) // For finding expiring subscriptions
  @@map("subscriptions")
}

model Invoice {
  id               String    @id @default(uuid())
  subscriptionId   String
  stripeInvoiceId  String?   @unique
  amount           Int       // in cents
  currency         String    @default("BRL")
  status           String    // draft, open, paid, void, uncollectible
  paidAt           DateTime?
  dueDate          DateTime?
  invoiceUrl       String?
  createdAt        DateTime  @default(now())

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

// ============================================
// ANALYTICS & EVENTS
// ============================================

model Event {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  eventType String   // user.registered, plan.generated, etc
  payload   Json
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  metadata  Json?

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@map("events")
}
