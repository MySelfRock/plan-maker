# Database
DATABASE_URL="postgresql://planmaker:planmaker_dev_password@localhost:5432/planmaker"

# Redis
REDIS_URL="redis://localhost:6379"

# Gemini AI
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-pro"

# AWS S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_ASSETS="planmaker-assets"
S3_BUCKET_EXPORTS="planmaker-exports"
USE_MINIO="true"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@planmaker.io"
EMAIL_FROM_NAME="PlanMaker"

# Worker Configuration
NODE_ENV="development"
WORKER_CONCURRENCY=5
LOG_LEVEL="info"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3001"
